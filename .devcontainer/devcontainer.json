{
    "name": "Template Python Project",
    "dockerComposeFile": "compose.yaml",
    "service": "devcontainer",
    "workspaceFolder": "/workspace/${localWorkspaceFolderBasename}",
    "customizations": {
        "vscode": {
            "settings": {
                "python-envs.terminal.autoActivationType": "shellStartup"
            },
            "extensions": [
                "github.copilot-chat",
                // "humao.rest-client", // REST Client to send HTTP request and view response
                "solomonkinard.git-blame",  // Git Blame extension
                "task.vscode-task", // Extension for task
                "vscode-icons-team.vscode-icons",
                "zxchhh.jetbrains-dark-new-ui",
                // Development
                "ms-python.debugpy", // Python Debugger extension using debugpy
                "ms-python.python", // Python language support
                "ms-python.vscode-pylance", // A performant, feature-rich language server for Python
                "ms-python.vscode-python-envs", // Extension for managing Python environments
                // Productivity, docs, and formatting
                "astral-sh.ty", // Extension for ty, an fast type checker and language server
                "charliermarsh.ruff", // Extension for Ruff
                "redhat.vscode-yaml", // YAML language support
                "tamasfe.even-better-toml", // Syntax highlighting and formatting of TOML files
                // "yzhang.markdown-all-in-one",
                // "DavidAnson.vscode-markdownlint"
                "christian-kohler.path-intellisense" // Autocompletes filenames
            ]
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2.5.9": {
            "username": "vscode"
        },
        "ghcr.io/devcontainers/features/git:1.3.8": {
            "version": "2.55.0"
        }
    },
    "remoteUser": "vscode",
    // "containerUser": "vscode",
    // "updateRemoteUserUID": true,
    "postCreateCommand": {
        "Initialize environment": "zsh ./.devcontainer/post-create.sh"
    }
    // "postAttachCommand": {
    //     "Change workspace folder owner": "sudo chown -R vscode:vscode /workspaces",
    //     "Install dependencies": "uv sync"
    // },
    // "waitFor": "postCreateCommand"
}