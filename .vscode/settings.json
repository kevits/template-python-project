{
    "[dockerfile]": {
        "editor.rulers": [
            120
        ]
    },
    "[markdown]": {
        "editor.defaultFormatter": "yzhang.markdown-all-in-one",
        "editor.formatOnSave": true
    },
    "[python]": {
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "always",
            "source.organizeImports": "always",
        },
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnPaste": true,
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.rulers": [
            120
        ],
    },
    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml"
    },
    "debug.internalConsoleOptions": "neverOpen",
    "debug.closeReadonlyTabsOnEnd": true,
    "evenBetterToml.formatter.alignComments": true,
    "evenBetterToml.formatter.alignEntries": true,
    "evenBetterToml.formatter.allowedBlankLines": 2,
    "evenBetterToml.formatter.arrayAutoCollapse": true,
    "evenBetterToml.formatter.arrayTrailingComma": true,
    "evenBetterToml.formatter.columnWidth": 120,
    "evenBetterToml.formatter.trailingNewline": true,
    "files.exclude": {
        "**/__pycache__": true
    },
    "files.trimTrailingWhitespace": true,
    "git-blame.config.inlineBlame.hoverMessage.activeLine": false,
    "git-blame.config.inlineBlameHoverMessage": true,
    "git-blame.config.inlineBlameStartColumn": 120,
    "git-blame.config.showBlameInline": false,
    "github.copilot.chat.commitMessageGeneration.instructions": [
        {
            "file": ".commit-message-instructions.md"
        },
    ],
    "python.analysis.inlayHints.callArgumentNames": "off",
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.variableTypes": true,
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.env.linux": {
        "WORKSPACE_FOLDER": "${workspaceFolder}",
    },
    "terminal.integrated.stickyScroll.enabled": false,
    "ty.inlayHints.callArgumentNames": false,
    "remote.restoreForwardedPorts": false,
    "remote.autoForwardPortsFallback": 0,
    "ruff.configuration": "${workspaceFolder}/pyproject.toml",
    "ruff.nativeServer": "on",
    "workbench.iconTheme": "vscode-icons",
    "workbench.preferredDarkColorTheme": "JetBrains Dark (New UI)",
    "workbench.preferredLightColorTheme": "JetBrains Dark (New UI)",
}